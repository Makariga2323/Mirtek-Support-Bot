# Скопируйте в .env (он в .gitignore). Токены через запятую, без пробелов и кавычек.
API_TOKENS=token_1,token_2
# Адреса фронтенда (Live Server). Через запятую.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Режим ядра: rules (по данным, без модели, рекомендуется сейчас), llm (данные + модель) или stub (демо-заглушки)
CORE_MODE=rules
DB_PATH= data/app.sqlite3
REQUEST_BUDGET_S=5
SESSION_TTL_S= 3600
MESSAGE_RETENTION_S=604800
STALE_PROCESSING_S=60
# Токены оператора (очередь заявок). Отличаются от API_TOKENS. Через запятую.
OPERATOR_TOKENS=operator_token_1

# Для режима llm: CORE_MODE=llm и параметры ниже
# Любой OpenAI-совместимый API. Ключ не коммитьте, .env в .gitignore.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Путь к данным (по умолчанию data/MOCK_DATA.json в корне репозитория)
# DATA_PATH=
